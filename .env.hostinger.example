# Copier vers .env avant db:mysql:push (ne pas commiter .env)
# hPanel → Bases de données → MySQL → créer base + utilisateur

# Hôte souvent : localhost (depuis le serveur Hostinger)
# ou srv123.hstgr.io selon votre panneau — lisez l’écran « Remote MySQL » / détails de la base
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/u123456789_bookflow"

AUTH_SECRET="remplacer-par-openssl-rand-base64-32"
AUTH_URL="https://votredomaine.com"
NEXT_PUBLIC_APP_URL="https://votredomaine.com"
NODE_ENV="production"

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@votredomaine.com"
SMTP_PASS="mot-de-passe-boite-mail"
MAIL_FROM="BOOKFLOW <noreply@votredomaine.com>"
