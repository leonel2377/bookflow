# --- Développement (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production Hostinger (MySQL) — remplacer provider dans prisma/schema.prisma par "mysql" ---
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

AUTH_SECRET="générez-une-clé-32-caractères-minimum"
# En production : https://votredomaine.com
AUTH_URL="http://localhost:3000"

# URL publique de l'app (liens dans les e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"

# SMTP (obligatoire en production pour mot de passe oublié)
# Hostinger : créez une boîte noreply@votredomaine.com dans hPanel → E-mails
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@votredomaine.com"
SMTP_PASS="mot-de-passe-boite-mail"
MAIL_FROM="BOOKFLOW <noreply@votredomaine.com>"
